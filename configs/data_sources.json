  },
  "version_policy": {
    "freeze_one_reproducible_release": true,
    "do_not_chase_latest_quarter": true,
    "depmap_release_id_required": true,
    "network_notes": "2026-09-22 核验：旧 GDSC 下载路径返回 410；DepMap 个别下载入口有人机验证；DGIdb 下载页未返回可解析正文。执行时走官方页面、官方 release 归档或已核验本地文件，不绕过登录或访问限制；上述情况不等于资源停止服务，也不表示下载成功"
  },
